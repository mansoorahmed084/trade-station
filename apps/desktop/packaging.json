{
    "appId": "local.tradestation.desktop",
    "productName": "Trade Station",
    "copyright": "Trade Station",
    "directories": { "output": "dist", "buildResources": "build-resources" },
    "files": ["main.js", "package.json"],
    "extraResources": [
        { "from": "build/server", "to": "server" },
        { "from": "../web/dist", "to": "web", "filter": ["**/*", "!**/*.map", "!bench.html"] }
    ],
    "asar": true,
    "npmRebuild": false,
    "mac": {
        "category": "public.app-category.finance",
        "icon": "build-resources/icon.icns",
        "target": [{ "target": "dmg", "arch": ["arm64"] }],
        "hardenedRuntime": true,
        "entitlements": "build-resources/hardened-runtime.plist",
        "entitlementsInherit": "build-resources/hardened-runtime.plist"
    },
    "dmg": { "title": "Trade Station" },
    "win": {
        "icon": "build-resources/icon.png",
        "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
        "oneClick": false,
        "perMachine": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "Trade Station",
        "artifactName": "Trade Station Setup ${version}.${ext}"
    }
}
