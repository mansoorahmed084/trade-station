{
    "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
    "files": {
        "includes": [
            "apps/**",
            "packages/**",
            "tests/**",
            "spikes/**",
            "*.ts",
            "*.json",
            "!**/dist",
            "!**/node_modules"
        ]
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "off",
                "useImportType": "error"
            },
            "suspicious": {
                "noExplicitAny": "off",
                "noConfusingVoidType": "off",
                "noAssignInExpressions": "off"
            },
            "complexity": {
                "noForEach": "off"
            },
            "a11y": {
                "recommended": false
            },
            "correctness": {
                "useExhaustiveDependencies": "off"
            }
        }
    }
}
